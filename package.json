{
  "name": "openclaw-loops-poc",
  "version": "1.0.0-alpha.17",
  "private": true,
  "type": "module",
  "description": "Inspectable, bounded loops for OpenClaw chat and native UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jacob-J-Thomas/openclaw-loops.git"
  },
  "homepage": "https://github.com/Jacob-J-Thomas/openclaw-loops#readme",
  "bugs": {
    "url": "https://github.com/Jacob-J-Thomas/openclaw-loops/issues"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "examples",
    "README.md",
    "docs/FORMAT.md",
    "docs/CAPABILITIES.md",
    "docs/VERIFICATION.md",
    "docs/DELIVERY_PLAN.md",
    "docs/DELIVERY_STATUS.md",
    "docs/RELEASE_SCOPE.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "docs/UPSTREAM_REQUIREMENTS.md",
    "docs/DEPLOYMENT.md",
    "docs/THIRD_PARTY_NOTICES.md",
    "docs/TRANSPORT.md",
    "docs/HISTORY.md",
    "docs/RECOVERY.md",
    "docs/INTERFACES.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/license-notices.mjs && node scripts/build.mjs && bash scripts/dev.sh plugins build",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "host": "openclaw",
    "dev": "bash scripts/dev.sh"
  },
  "peerDependencies": {
    "openclaw": "2026.9.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "openclaw": "2026.9.3",
    "playwright-core": "1.63.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "controlUi": "./src/control-ui.tsx",
    "compat": {
      "pluginApi": "2026.9.3"
    },
    "build": {
      "openclawVersion": "2026.9.3"
    }
  },
  "dependencies": {
    "@xyflow/react": "12.11.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typebox": "1.3.30"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "license": "MIT"
}
