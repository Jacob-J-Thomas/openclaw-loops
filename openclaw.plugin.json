{
  "id": "loops-poc",
  "name": "Loops",
  "version": "1.0.0-alpha.17",
  "description": "Inspectable, bounded loops shared by native UI and chat.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "maxConcurrentRuns": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991,
        "default": 1,
        "description": "Maximum executing/settling runs. Additional requests queue. Keep 1 for a 16 GB local-model machine."
      },
      "budgets": {
        "type": "object",
        "properties": {
          "definitionBytes": {
            "type": "integer",
            "minimum": 128,
            "maximum": 9007199254740991
          },
          "inputBytes": {
            "type": "integer",
            "minimum": 2,
            "maximum": 9007199254740991
          },
          "promptBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "defaultOutputBytes": {
            "type": "integer",
            "minimum": 128,
            "maximum": 9007199254740991
          },
          "defaultExecutions": {
            "type": "integer",
            "minimum": 2,
            "maximum": 9007199254740991
          },
          "defaultRepeat": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false
      }
    }
  },
  "controlUi": {
    "entry": "dist/control-ui/cd98a0862f14eda5c4a8b7933b931effabe694f95134feb670124246b1484a03/index.js"
  },
  "contracts": {
    "tools": [
      "loops_archive",
      "loops_browse",
      "loops_cancel",
      "loops_capabilities",
      "loops_create",
      "loops_delete",
      "loops_deleted",
      "loops_describe",
      "loops_document",
      "loops_document_acquire",
      "loops_document_release",
      "loops_draft",
      "loops_edit",
      "loops_enable",
      "loops_history",
      "loops_inspect",
      "loops_library",
      "loops_list",
      "loops_read",
      "loops_maintenance",
      "loops_output",
      "loops_publish",
      "loops_recover",
      "loops_restore",
      "loops_resume",
      "loops_retention",
      "loops_retry",
      "loops_revoke",
      "loops_run",
      "loops_runs",
      "loops_save",
      "loops_status",
      "loops_test",
      "loops_transport_release",
      "loops_upload",
      "loops_validate",
      "loops_versions"
    ]
  }
}
